# Copy to .env and adjust: cp .env.example .env
# Real environment variables override values in this file.

# Set to False in production. Truthy values: 1, true, yes, on.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is False. Generate one with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Comma-separated. Defaults to localhost,127.0.0.1 when DEBUG, empty otherwise.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API (React dev server by default).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP (Gmail) credentials. Leave empty in development to print emails to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# "From" address on emails sent by the app (e.g. invoices emailed to clients).
DJANGO_DEFAULT_FROM_EMAIL="Smart Invoice <noreply@localhost>"

# Public URL of the React frontend, used to build links in emails (no trailing slash).
DJANGO_FRONTEND_URL=http://localhost:3000
